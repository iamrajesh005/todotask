<% layout('layout/temp') -%>

<body class="min-h-screen bg-slate-950 text-white">

  <!-- Flash messages -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <%- include("./include/flashmsg.ejs") %>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex flex-col lg:flex-row gap-6">

      <!-- ── LEFT SIDEBAR: Stats ── -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="bg-gradient-to-br from-indigo-600 to-blue-700 rounded-2xl p-6 shadow-xl shadow-indigo-900/40">

          <!-- Date -->
          <div class="mb-6">
            <p class="text-5xl font-black tracking-tight leading-none"><%= day %></p>
            <p class="text-base font-semibold text-indigo-200 mt-1"><%= month %>, <%= year %></p>
          </div>

          <div class="h-px bg-white/20 mb-5"></div>

          <!-- Stats -->
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between bg-white/10 rounded-xl px-4 py-3">
              <span class="text-sm text-indigo-200">Total</span>
              <span class="text-xl font-bold"><%= getTasks.length %></span>
            </div>
            <div class="flex items-center justify-between bg-white/10 rounded-xl px-4 py-3">
              <span class="text-sm text-indigo-200">Active</span>
              <span class="text-xl font-bold text-yellow-300"><%= notcomTask.length %></span>
            </div>
            <div class="flex items-center justify-between bg-white/10 rounded-xl px-4 py-3">
              <span class="text-sm text-indigo-200">Done</span>
              <span class="text-xl font-bold text-emerald-300"><%= comTask.length %></span>
            </div>
          </div>

          <!-- Progress bar -->
          <% if (getTasks.length > 0) { %>
          <div class="mt-5">
            <div class="flex justify-between text-xs text-indigo-200 mb-1.5">
              <span>Progress</span>
              <span><%= Math.round((comTask.length / getTasks.length) * 100) %>%</span>
            </div>
            <div class="w-full bg-white/20 rounded-full h-2">
              <div
                class="bg-emerald-400 h-2 rounded-full transition-all"
                style="width: <%= Math.round((comTask.length / getTasks.length) * 100) %>%"
              ></div>
            </div>
          </div>
          <% } %>
        </div>
      </aside>

      <!-- ── MAIN CONTENT ── -->
      <main class="flex-1 min-w-0">

        <!-- Add task form -->
        <section class="mb-6">
          <h2 class="text-lg font-bold text-white mb-3">Add a task</h2>
          <%- include("./include/form.ejs") %>
        </section>

        <!-- Task list header -->
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-bold text-white">Your Tasks</h2>
          <span class="text-xs text-slate-400 bg-white/5 border border-white/10 px-2.5 py-1 rounded-full"><%= getTasks.length %> total</span>
        </div>

        <!-- Tasks -->
        <% if (getTasks.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-20 text-center bg-white/5 border border-white/10 rounded-2xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-slate-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
          <p class="text-slate-400 text-sm">No tasks yet. Add your first one above.</p>
        </div>
        <% } %>

        <div class="flex flex-col gap-3">
          <% for(task of getTasks){ %>
          <div class="group bg-white/5 hover:bg-white/8 border border-white/10 hover:border-white/20 rounded-2xl p-4 transition-all">
            <div class="flex flex-col sm:flex-row sm:items-start gap-3">

              <!-- Checkbox column -->
              <form method="post" action="/todo/<%= task._id %>/toggle?_method=PATCH" class="pt-0.5 shrink-0">
                <input
                  type="checkbox"
                  name="isDone"
                  onchange="this.form.submit()"
                  <%= task.isDone ? 'checked' : '' %>
                  class="w-5 h-5 rounded-md accent-indigo-500 cursor-pointer mt-0.5"
                />
              </form>

              <!-- Content -->
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-white text-base leading-snug <%= task.isDone ? 'line-through text-slate-500' : '' %>">
                  <%= task.taskname %>
                </h3>
                <% if (task.description) { %>
                <p class="text-sm text-slate-400 mt-0.5 truncate"><%= task.description %></p>
                <% } %>
                <p class="text-xs text-slate-500 mt-1 flex items-center gap-1">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  Due: <%= task.compDate %>
                </p>
              </div>

              <!-- Badges & actions -->
              <div class="flex flex-wrap items-center gap-2 shrink-0">

                <!-- Status badge -->
                <% if (task.isDone) { %>
                <span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span> Done
                </span>
                <% } else { %>
                <span class="inline-flex items-center gap-1 text-xs font-medium px-2.5 py-1 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/25">
                  <span class="w-1.5 h-1.5 rounded-full bg-amber-400 inline-block"></span> Active
                </span>
                <% } %>

                <!-- Priority badge -->
                <% if(task.priority === "high-priority") { %>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-red-500/15 text-red-400 border border-red-500/25">🔴 High</span>
                <% } else if(task.priority === "medium-priority") { %>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-yellow-500/15 text-yellow-400 border border-yellow-500/25">🟡 Medium</span>
                <% } else { %>
                <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/25">🟢 Low</span>
                <% } %>

                <!-- Actions -->
                <a href="/todo/<%= task._id %>/update" class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-400 hover:bg-indigo-500/15 transition-all" title="Edit">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                  </svg>
                </a>

                <form method="post" action="/todo/<%= task._id %>?_method=DELETE">
                  <button type="submit" class="p-1.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-red-500/15 transition-all" title="Delete"
                    onclick="return confirm('Delete this task?')">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </form>

              </div>
            </div>
          </div>
          <% } %>
        </div>
      </main>

      <!-- ── RIGHT SIDEBAR: Search ── -->
      <aside class="w-full lg:w-64 shrink-0">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5 sticky top-24">
          <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-4">Search</h3>
          <form action="/todo/search" method="get" role="search">
            <div class="flex gap-2">
              <input
                type="text"
                placeholder="Search tasks…"
                name="taskname"
                class="flex-1 min-w-0 bg-white/10 border border-white/10 text-white placeholder-slate-500 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
              />
              <button type="submit" class="shrink-0 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl px-3 py-2 transition-all active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
              </button>
            </div>
          </form>

          <!-- Quick filters hint -->
          <div class="mt-5 pt-4 border-t border-white/10">
            <p class="text-xs text-slate-500 mb-3 font-medium uppercase tracking-wider">Priority</p>
            <div class="flex flex-col gap-1.5">
              <a href="/todo/search?priority=high-priority" class="text-xs text-red-400 hover:text-red-300 hover:bg-red-500/10 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-400 shrink-0"></span> High Priority
              </a>
              <a href="/todo/search?priority=medium-priority" class="text-xs text-yellow-400 hover:text-yellow-300 hover:bg-yellow-500/10 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-yellow-400 shrink-0"></span> Medium Priority
              </a>
              <a href="/todo/search?priority=low-priority" class="text-xs text-blue-400 hover:text-blue-300 hover:bg-blue-500/10 px-2.5 py-1.5 rounded-lg transition-all flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-400 shrink-0"></span> Low Priority
              </a>
            </div>
          </div>
        </div>
      </aside>

    </div>
  </div>

</body>
